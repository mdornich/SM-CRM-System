<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stablemischief.smcrm-reviewgate</string>

    <!-- Phase 13A S1 §5.2. Mac mini paths: this job is the always-on review
         gate on the mini (980macmini), not the MacBook Pro. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>/Users/980macmini/Documents/GitHub/SM-CRM-System/scripts/review-gate.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive is a DICTIONARY, not <true/>, and that distinction is the
         whole point. launchd ORs these keys (launchd.plist(5)); if none of them
         matches it "falls back on demand based invocation" — it stops the job.

           SuccessfulExit=true  -> restart after a clean exit 0. A server that
                                   returns 0 has ended unexpectedly; bring it back.
           Crashed=true         -> restart after a signal death (SIGSEGV, SIGKILL,
                                   OOM). Also unexpected; bring it back.

         A non-zero exit matches NEITHER, so review-gate.sh's exit 78 —
         "refusing to start, the config would give you a mock-backed gate" —
         stops the job instead of respawning it every ThrottleInterval forever.
         With <true/> a misconfigured mini would loop every 10s indefinitely and
         the only evidence would be the log it is spamming. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <true/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Back off between crashes so a config error doesn't spin-loop. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logs live outside ~/Documents so launchd can write them under TCC. -->
    <key>StandardOutPath</key>
    <string>/Users/980macmini/.980labsOS/smcrm/review-gate.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/980macmini/.980labsOS/smcrm/review-gate.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/980macmini/Documents/GitHub/SM-CRM-System</string>
</dict>
</plist>
